# Production Droplet environment — copy to /opt/jamii-aide-backend/.env on the server
# Do NOT use local development values in production.

DEBUG=False
SECRET_KEY=<strong-random-secret-at-least-32-chars>
ALLOWED_HOSTS=api.jamiiaide.com

USE_SQLITE=False
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

# Browser frontend origins (landing + full app)
CORS_ORIGINS=https://jamiiaide.com,https://app.jamiiaide.com
CSRF_TRUSTED_ORIGINS=https://jamiiaide.com,https://app.jamiiaide.com

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=notifications@jamiiaide.com

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Celery (if using async email / M-Pesa receipts)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_INLINE_FALLBACK=False
CELERY_BROKER_CONNECTION_TIMEOUT=2
CELERY_SOCKET_CONNECT_TIMEOUT=2
CELERY_SOCKET_TIMEOUT=2

# Optional mail timeout to avoid long SMTP blocking in workers
EMAIL_TIMEOUT=20
